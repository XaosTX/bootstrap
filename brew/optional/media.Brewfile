# Optional: media (from codeangler's bootstrap, MIT). Offered by steps/optional/darwin/60_brew_optional.sh.
# brew bundle --file=./tools/brew/archiving-media/Brewfile
cask "vlc"
cask "musicbrainz-picard"
cask "audacity"
# cask "macx-dvd-ripper-mac-free-edition"
cask "makemkv"  # export TITLE=HISTORY_OF_SPAIN_DVD_1 && HandBrakeCLI -Z "Fast 1080p30" -i ~/Movies/backup/$TITLE.iso -o ~/Movies/archiving-media/$TITLE.mp4
brew "handbrake"   # export TITLE=HISTORY_OF_SPAIN_DVD_1  && HandBrakeCLI -i ~/Volumes/$TITLE -o ~/Movies/archiving-media/$TITLE.mp4 -e x264 -q <quality_level>
brew "ffmpeg"
# brew "youtube-dl"
cask "chromedriver"
brew "poppler"  # wrapper for pdfunite in ruby
brew "id3v2"  # https://id3v2.sourceforge.net/
